# Copiá este archivo como .env y completá los valores. Nunca commitees .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# URL de contacto que va en el User-Agent del scanner. Obligatoria en producción.
AUDITOR_CONTACT_URL=https://example.invalid/contacto
DATABASE_PATH=./data/auditor.db

# --- Panel de consultores (H12) ---
# En producción la API no arranca si alguna falta o si quedó el valor de relleno.
# Origen exacto de la web (https y sin barra final en producción). En desarrollo: http://localhost:5173
PUBLIC_ORIGIN=https://auditor.example.invalid
# Primer usuario: se crea solo si no existe ninguno; nunca pisa una contraseña existente.
ADMIN_EMAIL=admin@example.invalid
# Generalo con `pnpm --filter @auditor/api user:hash` (pide la contraseña sin mostrarla).
# El hash tiene signos $: dejalo ENTRE COMILLAS SIMPLES, así ni Node ni Docker Compose los interpretan.
# Ejemplo: ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...$...'
ADMIN_PASSWORD_HASH=reemplazar-por-la-salida-de-pnpm-user-hash
# Sal para hashear IPs (32 caracteres o más). Por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_HASH_SALT=reemplazar-por-32-o-mas-caracteres-aleatorios

{
  "name": "@auditor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "user:hash": "tsx --conditions=development src/cli/hash-password.ts"
  },
  "dependencies": {
    "@auditor/scanner": "workspace:*",
    "@auditor/shared": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "^13.2.0",
    "argon2": "0.45.2",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
